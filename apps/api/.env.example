# ── Servidor ──
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173

# ── Base de datos (docker-compose) ──
DATABASE_URL=postgresql://gymtonic:gymtonic@localhost:5432/gymtonic?schema=public

# ── Redis (jobs / colas, fase 7) ──
REDIS_URL=redis://localhost:6379

# ── Auth (fase 2) — generar con: openssl rand -base64 48 ──
JWT_ACCESS_SECRET=cambiar-por-un-secreto-largo-de-al-menos-32-caracteres
JWT_REFRESH_SECRET=cambiar-por-otro-secreto-largo-de-al-menos-32-caracteres

# ── Email (Mailhog en desarrollo) ──
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="Gym Tonic <no-reply@gymtonic.local>"

# ── ExerciseDB ──
EXERCISEDB_BASE_URL=https://www.exercisedb.dev/api/v1

# ── Seed ──
SEED_ADMIN_EMAIL=admin@gymtonic.local
SEED_DEFAULT_PASSWORD=Gymtonic123
