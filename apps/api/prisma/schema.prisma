// Modelo de datos de Gym Tonic.
// Los enums deben mantenerse sincronizados con packages/shared/src/enums.ts

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Enums ───────────────────────────────

enum Role {
  MEMBER
  TRAINER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
}

enum PaymentMethod {
  MERCADOPAGO
  CASH
  TRANSFER
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  REFUNDED
}

enum AccessResult {
  ALLOWED
  WARNED
  DENIED
}

enum PayrollStatus {
  PENDING
  PAID
}

enum NotificationType {
  DUE_SOON
  DEBT_ONE
  ACCESS_BLOCKED
  ROUTINE_ASSIGNED
  PAYMENT_CONFIRMED
  PAYROLL_PAID
}

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
}

// ───────────────────────────── Usuarios ──────────────────────────────

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  role         Role       @default(MEMBER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  memberProfile     MemberProfile?
  trainerProfile    TrainerProfile?
  students          MemberProfile[]    @relation("TrainerStudents")
  refreshTokens     RefreshToken[]
  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  auditLogs         AuditLog[]
  pricesCreated     MembershipPrice[]
  paymentsRecorded  Payment[]          @relation("PaymentRegisteredBy")

  @@index([role, status])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MemberProfile {
  userId              String    @id @db.Uuid
  birthDate           DateTime? @db.Date
  trainerId           String?   @db.Uuid
  /// Secreto con el que se firman los QR rotativos del alumno. Rotarlo invalida los QR previos.
  qrSecret            String    @unique @default(uuid())
  onboardingCompleted Boolean   @default(false)
  /// Fecha desde la que se generan las cuotas (día de vencimiento mensual).
  membershipStartDate DateTime  @default(now()) @db.Date
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  trainer        User?           @relation("TrainerStudents", fields: [trainerId], references: [id], onDelete: SetNull)
  schedules      Schedule[]
  progress       ProgressEntry[]
  routines       Routine[]
  routineChecks  RoutineCheck[]
  invoices       Invoice[]
  accessLogs     AccessLog[]

  @@index([trainerId])
}

model TrainerProfile {
  userId         String   @id @db.Uuid
  hourlyRate     Decimal  @default(0) @db.Decimal(12, 2)
  perStudentRate Decimal  @default(0) @db.Decimal(12, 2)
  specialty      String?
  bio            String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  availability TrainerSchedule[]
  routines     Routine[]
  shifts       TrainerShift[]
  payrolls     Payroll[]
}

// ───────────────────────────── Horarios ──────────────────────────────

/// Horario elegido por el alumno (ABM).
model Schedule {
  id        String   @id @default(uuid()) @db.Uuid
  memberId  String   @db.Uuid
  /// 0 = domingo ... 6 = sábado
  dayOfWeek Int      @db.SmallInt
  /// HH:mm
  startTime String   @db.VarChar(5)
  /// HH:mm
  endTime   String   @db.VarChar(5)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  member MemberProfile @relation(fields: [memberId], references: [userId], onDelete: Cascade)

  @@index([memberId, dayOfWeek])
}

/// Disponibilidad del entrenador (para sugerir entrenadores compatibles con el horario del alumno).
model TrainerSchedule {
  id        String @id @default(uuid()) @db.Uuid
  trainerId String @db.Uuid
  dayOfWeek Int    @db.SmallInt
  startTime String @db.VarChar(5)
  endTime   String @db.VarChar(5)

  trainer TrainerProfile @relation(fields: [trainerId], references: [userId], onDelete: Cascade)

  @@index([trainerId, dayOfWeek])
}

// ───────────────────────────── Progreso ──────────────────────────────

model ProgressEntry {
  id        String   @id @default(uuid()) @db.Uuid
  memberId  String   @db.Uuid
  date      DateTime @default(now()) @db.Date
  weightKg  Decimal? @db.Decimal(5, 2)
  heightCm  Decimal? @db.Decimal(5, 2)
  /// Edad al momento del registro (snapshot calculado desde birthDate).
  age       Int?     @db.SmallInt
  notes     String?
  createdAt DateTime @default(now())

  member MemberProfile @relation(fields: [memberId], references: [userId], onDelete: Cascade)

  @@index([memberId, date])
}

// ───────────────────────────── Rutinas ───────────────────────────────

/// Caché local de ejercicios de ExerciseDB (https://github.com/exercisedb/exercisedb-api).
model ExerciseCache {
  externalId    String   @id
  name          String
  gifUrl        String?
  targetMuscles String[]
  bodyParts     String[]
  equipments    String[]
  secondaryMuscles String[]
  instructions  Json?
  fetchedAt     DateTime @default(now())

  routineExercises RoutineExercise[]

  @@index([name])
}

model Routine {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  description String?
  trainerId   String    @db.Uuid
  memberId    String    @db.Uuid
  startDate   DateTime  @default(now()) @db.Date
  endDate     DateTime? @db.Date
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  trainer TrainerProfile @relation(fields: [trainerId], references: [userId], onDelete: Restrict)
  member  MemberProfile  @relation(fields: [memberId], references: [userId], onDelete: Cascade)
  days    RoutineDay[]

  @@index([memberId, active])
  @@index([trainerId])
}

model RoutineDay {
  id        String @id @default(uuid()) @db.Uuid
  routineId String @db.Uuid
  order     Int    @db.SmallInt
  /// Día de la semana sugerido (opcional), 0-6.
  dayOfWeek Int?   @db.SmallInt
  title     String

  routine   Routine           @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exercises RoutineExercise[]
  checks    RoutineCheck[]

  @@unique([routineId, order])
}

model RoutineExercise {
  id                 String   @id @default(uuid()) @db.Uuid
  routineDayId       String   @db.Uuid
  exerciseExternalId String
  order              Int      @db.SmallInt
  sets               Int      @db.SmallInt
  reps               String   @db.VarChar(20) // "12", "8-10", "30s"
  restSec            Int?     @db.SmallInt
  weightKg           Decimal? @db.Decimal(6, 2)
  notes              String?

  routineDay RoutineDay     @relation(fields: [routineDayId], references: [id], onDelete: Cascade)
  exercise   ExerciseCache  @relation(fields: [exerciseExternalId], references: [externalId], onDelete: Restrict)
  checks     RoutineCheck[]

  @@index([routineDayId, order])
}

/// Check de rutina: un registro por ejercicio completado (o por día completo si routineExerciseId es null).
model RoutineCheck {
  id                String   @id @default(uuid()) @db.Uuid
  memberId          String   @db.Uuid
  routineDayId      String   @db.Uuid
  routineExerciseId String?  @db.Uuid
  completedAt       DateTime @default(now())

  member          MemberProfile    @relation(fields: [memberId], references: [userId], onDelete: Cascade)
  routineDay      RoutineDay       @relation(fields: [routineDayId], references: [id], onDelete: Cascade)
  routineExercise RoutineExercise? @relation(fields: [routineExerciseId], references: [id], onDelete: Cascade)

  @@index([memberId, completedAt])
}

// ─────────────────────────── Facturación ─────────────────────────────

/// Histórico de precios de la mensualidad. El vigente es el de mayor validFrom <= hoy.
model MembershipPrice {
  id          String   @id @default(uuid()) @db.Uuid
  amount      Decimal  @db.Decimal(12, 2)
  validFrom   DateTime @db.Date
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([validFrom])
}

/// Cuota mensual del alumno.
model Invoice {
  id        String        @id @default(uuid()) @db.Uuid
  memberId  String        @db.Uuid
  /// YYYY-MM
  period    String        @db.VarChar(7)
  amount    Decimal       @db.Decimal(12, 2)
  dueDate   DateTime      @db.Date
  status    InvoiceStatus @default(PENDING)
  paidAt    DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  member   MemberProfile @relation(fields: [memberId], references: [userId], onDelete: Cascade)
  payments Payment[]

  @@unique([memberId, period])
  @@index([status, dueDate])
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  invoiceId      String        @db.Uuid
  method         PaymentMethod
  status         PaymentStatus @default(PENDING)
  amount         Decimal       @db.Decimal(12, 2)
  /// ID del pago / preferencia en Mercado Pago.
  externalId     String?       @unique
  rawPayload     Json?
  registeredById String?       @db.Uuid
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  invoice      Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  registeredBy User?   @relation("PaymentRegisteredBy", fields: [registeredById], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([status, createdAt])
}

// ───────────────────────────── Accesos ───────────────────────────────

/// Ingreso del alumno por QR.
model AccessLog {
  id        String       @id @default(uuid()) @db.Uuid
  memberId  String       @db.Uuid
  scannedAt DateTime     @default(now())
  result    AccessResult
  reason    String?
  unpaidInvoices Int     @default(0) @db.SmallInt

  member MemberProfile @relation(fields: [memberId], references: [userId], onDelete: Cascade)

  @@index([memberId, scannedAt])
  @@index([scannedAt])
}

/// Ingreso / egreso del entrenador (para facturar horas).
model TrainerShift {
  id              String    @id @default(uuid()) @db.Uuid
  trainerId       String    @db.Uuid
  checkIn         DateTime  @default(now())
  checkOut        DateTime?
  durationMinutes Int?

  trainer TrainerProfile @relation(fields: [trainerId], references: [userId], onDelete: Cascade)

  @@index([trainerId, checkIn])
}

// ────────────────────────────── Nómina ───────────────────────────────

model Payroll {
  id             String        @id @default(uuid()) @db.Uuid
  trainerId      String        @db.Uuid
  /// YYYY-MM
  period         String        @db.VarChar(7)
  hoursWorked    Decimal       @db.Decimal(8, 2)
  studentsCount  Int
  hoursAmount    Decimal       @db.Decimal(12, 2)
  studentsAmount Decimal       @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  status         PayrollStatus @default(PENDING)
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  trainer TrainerProfile @relation(fields: [trainerId], references: [userId], onDelete: Restrict)

  @@unique([trainerId, period])
  @@index([period, status])
}

// ────────────────────────── Notificaciones ───────────────────────────

model Notification {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @db.Uuid
  type      NotificationType
  channel   NotificationChannel @default(IN_APP)
  title     String
  body      String
  /// Clave de idempotencia (ej. "DUE_SOON:2026-11") para no repetir avisos.
  dedupeKey String?
  readAt    DateTime?
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel, dedupeKey])
  @@index([userId, readAt])
}

model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  endpoint  String   @unique
  keys      Json
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ───────────────────────────── Auditoría ─────────────────────────────

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @db.Uuid
  action    String
  entity    String
  entityId  String?
  diff      Json?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([createdAt])
}
